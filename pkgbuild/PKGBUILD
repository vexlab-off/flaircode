pkgname=flaircode
pkgver=0.1.0
pkgrel=1
pkgdesc="L'éditeur de code de la suite flair"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
optdepends=("git: branche courante dans la barre d'état"
            'ttf-jetbrains-mono-nerd: la police de code préférée')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/flaircode "$pkgdir/usr/bin/flaircode"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/flaircode.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/flaircode.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "$startdir/icons/flaircode-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/flaircode.png"
  done
  install -Dm644 "$startdir/flaircode.desktop" "$pkgdir/usr/share/applications/flaircode.desktop"
}
